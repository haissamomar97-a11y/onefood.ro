# URL-ul public (folosit pentru SEO, sitemap, linkuri din emailuri)
NEXT_PUBLIC_SITE_URL=https://magiacasei.ro

# Baza de date pentru comenzi (Postgres: Neon / Supabase / Vercel Postgres).
# OBLIGATORIU în producție — fără ea comenzile sunt refuzate, ca să nu se piardă.
DATABASE_URL=

# Emailuri de confirmare prin SMTP (Newsman: datele SMTP din contul Newsman).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ORDER_EMAIL_FROM="Magia Casei <comenzi@magiacasei.ro>"
ORDER_NOTIFY_TO=contact@magiacasei.ro
