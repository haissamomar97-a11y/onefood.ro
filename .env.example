# URL-ul public (SEO, sitemap, linkuri NETOPIA)
NEXT_PUBLIC_SITE_URL=https://magiacasei.ro

# Baza de date pentru comenzi (Postgres, ex. Neon — regiunea Frankfurt).
# OBLIGATORIU în producție — fără ea comenzile sunt refuzate, ca să nu se piardă.
DATABASE_URL=

# Emailuri de confirmare prin SMTP (căsuța comenzi@magiacasei.ro de pe mail.desrv.eu)
SMTP_HOST=mail.desrv.eu
SMTP_PORT=587
SMTP_USER=comenzi@magiacasei.ro
SMTP_PASS=
ORDER_EMAIL_FROM="Magia Casei <comenzi@magiacasei.ro>"
ORDER_NOTIFY_TO=office@magiacasei.ro

# NETOPIA Payments (admin.netopia-payments.com). Fără ele, plata cu cardul e ascunsă.
NETOPIA_API_KEY=
NETOPIA_POS_SIGNATURE=
# Cheia publică din NETOPIA admin > Profil > Securitate (PEM; \n pentru rânduri noi)
NETOPIA_PUBLIC_KEY=
# 1 = sandbox (teste), 0 = plăți reale
NETOPIA_SANDBOX=1

# Panoul /admin (minim 12 caractere). Fără ea panoul e dezactivat.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
